{
  "name": "truthengine-classroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=development tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "firebase emulators:exec --only firestore,auth,storage --project demo-truthengine \"vitest run -c vitest.integration.config.ts\""
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-armenian": "5.3.0",
    "@google/genai": "1.52.0",
    "express": "4.22.3",
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "11.18.2",
    "lucide-react": "1.71.0",
    "mammoth": "1.13.0",
    "pdfkit": "0.20.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tsx": "4.23.15",
    "unpdf": "1.6.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "firebase-tools": "15.35.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
