{
  "name": "truthengine-classroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "1.52.0",
    "express": "4.22.3",
    "firebase": "11.10.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "11.18.2",
    "lucide-react": "1.71.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.15",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.2",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
