# ---- Server-only secrets (never prefix with VITE_) ----
# Gemini API key. In Google AI Studio, store it in Secrets instead of this file.
GEMINI_API_KEY=

# Firebase Admin credentials (service account). Either a full JSON string...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or rely on Application Default Credentials and set only the project id.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Optional model overrides (defaults live in src/server/config.ts).
GEMINI_MODEL_FAST=
GEMINI_MODEL_JUDGE=

PORT=3000

# ---- Public Firebase web config (safe to expose to the browser) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
